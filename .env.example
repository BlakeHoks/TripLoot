# Supabase project settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Public "anon" key (safe for the browser — access is enforced by RLS).
# NEVER put the service_role key here.
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: Google OAuth Client ID (Google Cloud → Google Auth Platform → Clients).
# Public value. When set, "Continue with Google" uses Google Identity Services on
# this site, so Google's dialog shows your domain instead of <ref>.supabase.co.
VITE_GOOGLE_CLIENT_ID=
